# Copy to .env. Keep the Gemini key on this server, never in Flutter assets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Use the same Firebase project as JotIt's existing Google account sign-in.
FIREBASE_PROJECT_ID=
HOST=127.0.0.1
PORT=8787
# Comma-separated web app origins. Native mobile requests use Firebase auth.
ALLOWED_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
REQUESTS_PER_MINUTE=5

# Optional, separately deployed shared-note-PIN recovery service.
# Keep the sender key on the server. Use a provider-verified sending domain.
RECOVERY_EMAIL_API_KEY=
RECOVERY_EMAIL_FROM=
RECOVERY_RESET_URL=
RECOVERY_APP_IDS=
RECOVERY_ALLOWED_ORIGINS=
RECOVERY_PORT=8788
# Optional account-based note backup/sync (separate service; never client secrets).
# Firebase stays on Spark; snapshot objects use a private Cloudflare R2 bucket.
CLOUD_APP_IDS=
CLOUD_ALLOWED_ORIGINS=
CLOUD_PORT=8789
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
