# Copy to .env. Keep the Gemini key on this server, never in Flutter assets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Use the same Firebase project as JotIt's existing Google account sign-in.
FIREBASE_PROJECT_ID=
HOST=127.0.0.1
PORT=8787
# Comma-separated web app origins. Native mobile requests use Firebase auth.
ALLOWED_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
REQUESTS_PER_MINUTE=5
